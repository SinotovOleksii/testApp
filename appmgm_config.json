{
  "node_image": "node:22-alpine",
  "packages": ["backend", "frontend"],
  "env_file": ".env",

  "network": "bridge",
  "ports": [
        { "host": 8000, "container": 3000, "protocol": "tcp" }
  ],

  "volumes": [
    {
      "host": "repo/backend",
      "container": "/app",
      "mode": "ro,Z"
    },
    {
      "host": "repo/frontend/dist",
      "container": "/app/public",
      "mode": "ro,Z"
    }
  ],

  "resources": {
    "memory": {
      "max": "512M",
      "high": "400M",
      "swap": "0"
    },
    "cpu": {
      "quota": "50%",
      "weight": 100
    }
  },

  "run_subdir": "",
  "command": ["npm", "start"]
}
