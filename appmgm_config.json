{
  "node_image": "node:22-alpine",
  "packages": ["backend", "frontend"],
  "env_file": ".env",
  "ports": [
        { "host": 8000, "container": 3000, "protocol": "tcp" }
  ],
  "network": "bridge",
  "volumes": [
    {
      "host": "repo/backend",
      "container": "/app",
      "mode": "ro,Z"
    },
    {
      "host": "repo/frontend/dist",
      "container": "/app/public",
      "mode": "ro,Z"
    }
  ],
  "run_subdir": "backend",
  "command": ["npm", "start"]
}
